+#if defined(TLS_FIXER_SSL_IN_BUFFER_INITIAL_LEN)
+/* The allocation may be small; the accepted record limit remains unchanged. */
+int mbedtls_ssl_grow_input_buffer(mbedtls_ssl_context *ssl, size_t needed)
+{
+    unsigned char **fields[] = { &ssl->in_ctr, &ssl->in_hdr, &ssl->in_len,
+                                &ssl->in_iv, &ssl->in_msg, &ssl->in_offt };
+    size_t offsets[sizeof(fields) / sizeof(fields[0])];
+    unsigned char *next;
+    size_t i;
+
+    if (needed > MBEDTLS_SSL_IN_BUFFER_LEN) {
+        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+    }
+    if (needed <= ssl->in_buf_len) {
+        return 0;
+    }
+    for (i = 0; i < sizeof(fields) / sizeof(fields[0]); i++) {
+        offsets[i] = *fields[i] == NULL ? 0 : (size_t) (*fields[i] - ssl->in_buf);
+        if (offsets[i] > ssl->in_buf_len) {
+            return MBEDTLS_ERR_SSL_INTERNAL_ERROR;
+        }
+    }
+    next = mbedtls_calloc(1, needed);
+    if (next == NULL) {
+        return MBEDTLS_ERR_SSL_ALLOC_FAILED;
+    }
+    memcpy(next, ssl->in_buf, ssl->in_buf_len);
+    /* Rebase while the old allocation is still valid, including in_offt. */
+    for (i = 0; i < sizeof(fields) / sizeof(fields[0]); i++) {
+        if (*fields[i] != NULL) {
+            *fields[i] = next + offsets[i];
+        }
+    }
+    mbedtls_zeroize_and_free(ssl->in_buf, ssl->in_buf_len);
+    ssl->in_buf = next;
+    ssl->in_buf_len = needed;
+    return 0;
+}
+#endif
 
